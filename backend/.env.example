# PostgreSQL (local example — adjust user/password/host)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/NetflixDB

JWT_SECRET=use_a_long_random_string
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional: must match what you type on signup to get role=admin (server default if unset: mysecretadmincode)
ADMIN_SECRET=mysecretadmincode

# TMDB (server-side; never expose to frontend). Used only to auto-fill an empty catalog on startup.
TMDB_TOKEN=
TMDB_API_KEY=
# TMDB_AUTO_SEED=true
# TMDB_SEED_MAX=50
# TMDB_SEED_TV_MAX=30
# TMDB_SEED_DELAY_MS=45

# Google Gemini
GOOGLE_GENAI_API_KEY=
# Optional comma-separated fallback list
GEMINI_MODEL=gemini-2.0-flash-001,gemini-2.0-flash

# Email (signup OTP / password reset) — Gmail: use an App Password, not your normal password
# https://support.google.com/accounts/answer/185833
EMAIL_USER=
EMAIL_PASS=
# Optional "From" display (defaults to EMAIL_USER)
# EMAIL_FROM="AIFlix <you@gmail.com>"
